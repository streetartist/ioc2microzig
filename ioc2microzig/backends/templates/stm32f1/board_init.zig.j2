}

fn initUarts() !void {
    // STM32F1 MicroZig UART setup generated from CubeMX USART/UART components.
{% for uart in uarts %}
{% for comment in uart.comments %}
    // {{ comment }}
{% endfor %}
    try {{ uart.alias }}.apply_runtime(.{
        .clock_speed = rcc.get_clock(.{{ uart.instance }}),
        .baud_rate = {{ uart.baud_rate }},
        .stop_bits = .{{ uart.stop_bits }},
        .parity = .{{ uart.parity }},
        .flow_control = .{{ uart.flow_control }},
    });
{% else %}
    // No UART setup inferred.
{% endfor %}
    // USER CODE BEGIN board_init.initUarts
    // USER CODE END board_init.initUarts
}
