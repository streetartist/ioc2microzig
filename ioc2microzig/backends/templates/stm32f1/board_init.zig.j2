pub fn init() !void {
    try initClocks();
    initGpio();
    initTimers();
    initSpis();
    try initI2cs();
    initAdcs();
    try initUarts();
    try generated.initAll();
    // USER CODE BEGIN board_init.init
    // USER CODE END board_init.init
}

const rcc = stm32.rcc;
const gpio = stm32.gpio;
const GPTimer = stm32.timer.GPTimer;

pub const pins = struct {
{% for pin in pins %}
    pub const {{ pin.alias }} = gpio.Pin.from_port(.{{ pin.port }}, {{ pin.number }});
{% else %}
    // No physical GPIO aliases.
{% endfor %}
};

{% if pwm_timers or counter_timers %}
{% for timer in pwm_timers %}
const {{ timer.alias }} = GPTimer.init(.{{ timer.instance }}).into_pwm_mode();
{% endfor %}
{% for timer in counter_timers %}
const {{ timer.alias }} = GPTimer.init(.{{ timer.instance }}).into_counter_mode();
{% endfor %}
{% else %}
// No generated timer aliases.
{% endif %}
{% for uart in uarts %}
const {{ uart.alias }} = stm32.uart.UART.init(.{{ uart.instance }});
{% else %}
// No generated UART aliases.
{% endfor %}
{% for i2c in i2cs %}
pub const {{ i2c.alias }} = stm32.i2c.I2C.init(.{{ i2c.instance }});
{% else %}
// No generated I2C aliases.
{% endfor %}
{% for spi in spis %}
pub const {{ spi.alias }} = stm32.spi.SPI.init(.{{ spi.instance }});
{% else %}
// No generated SPI aliases.
{% endfor %}
{% for adc in adcs %}
pub const {{ adc.alias }} = stm32.adc.ADC.init(.{{ adc.instance }});
{% else %}
// No generated ADC aliases.
{% endfor %}

pub const pwm = struct {
{% for output in pwm_outputs %}
    pub const {{ output.period_const }}: u16 = {{ output.period }};
    pub fn set_{{ output.suffix }}_duty(value: u16) void {
        {{ output.timer_alias }}.set_duty({{ output.channel }}, value);
    }
    pub fn enable_{{ output.suffix }}(enabled: bool) void {
        {{ output.timer_alias }}.set_channel({{ output.channel }}, enabled);
    }
{% else %}
    // No generated PWM outputs.
{% endfor %}
};

fn initClocks() !void {
{% if rcc.fields or rcc.flags %}
    _ = try rcc.apply(.{
{% for field in rcc.fields %}
        .{{ field.name }} = .{{ field.value }},
{% endfor %}
{% if rcc.flags %}
        .flags = .{
{% for flag in rcc.flags %}
            .{{ flag.name }} = {{ flag.value }},
{% endfor %}
        },
{% endif %}
    });
{% else %}
    // No supported CubeMX RCC clock tree entries were inferred.
{% endif %}
{% for port in gpio_ports %}
    rcc.enable_clock(.{{ port }});
{% endfor %}
{% if enable_afio %}
    rcc.enable_clock(.AFIO);
{% endif %}
{% for peripheral in peripheral_clocks %}
    rcc.enable_clock(.{{ peripheral }});
{% endfor %}
{% if not gpio_ports and not enable_afio and not peripheral_clocks %}
    // No GPIO/peripheral clocks inferred.
{% endif %}
    // CubeMX RCC summary:
{{ rcc_comments }}
    // USER CODE BEGIN board_init.initClocks
    // USER CODE END board_init.initClocks
}

fn initGpio() void {
    // STM32F1 MicroZig GPIO setup generated from CubeMX pins.
{% for pin in pins %}
{% if pin.setup.kind == "output" %}
{% if pin.setup.initial is defined %}
    pins.{{ pin.alias }}.put({{ pin.setup.initial }});
{% endif %}
    pins.{{ pin.alias }}.set_output_mode(.{{ pin.setup.mode }}, .{{ pin.setup.speed }}); // {{ pin.name }}: {{ pin.signal }}
{% elif pin.setup.kind == "input" %}
    pins.{{ pin.alias }}.set_input_mode(.{{ pin.setup.mode }});{% if pin.setup.pull %} pins.{{ pin.alias }}.set_pull(.{{ pin.setup.pull }});{% endif %} // {{ pin.name }}: {{ pin.signal }}
{% else %}
    // TODO configure {{ pin.name }} as {{ pin.signal }}.
{% endif %}
{% else %}
    // No GPIO pins selected.
{% endfor %}
    // USER CODE BEGIN board_init.initGpio
    // USER CODE END board_init.initGpio
}

fn initTimers() void {
    // STM32F1 MicroZig timer setup generated from CubeMX TIM components.
{% for timer in pwm_timers %}
    {{ timer.alias }}.configure(.{
        .prescaler = {{ timer.prescaler }},
        .auto_reload = {{ timer.period }},
        .counter_mode = .{ .up = {} },
    });
{% for channel in timer.channels %}
    {{ timer.alias }}.configure_channel({{ channel.index }}, .{ .fast_mode = true });
    {{ timer.alias }}.set_duty({{ channel.index }}, {{ channel.pulse }});
    {{ timer.alias }}.set_channel({{ channel.index }}, true);
{% endfor %}
    {{ timer.alias }}.force_update();
{% endfor %}
{% for timer in counter_timers %}
    {{ timer.alias }}.configure(.{
        .prescaler = {{ timer.prescaler }},
        .auto_reload = {{ timer.period }},
        .counter_mode = .{ .up = {} },
    });
{% else %}
{% if not pwm_timers %}
    // No timer setup inferred.
{% endif %}
{% endfor %}
    // USER CODE BEGIN board_init.initTimers
    // USER CODE END board_init.initTimers
}

fn initSpis() void {
    // STM32F1 MicroZig SPI setup generated from CubeMX SPI components.
{% for spi in spis %}
{% for comment in spi.comments %}
    // CubeMX {{ spi.instance }}: {{ comment }}
{% endfor %}
    {{ spi.alias }}.apply(.{
{% for field in spi.fields %}
        .{{ field.name }} = .{{ field.value }},
{% endfor %}
    });
{% else %}
    // No SPI setup inferred.
{% endfor %}
    // USER CODE BEGIN board_init.initSpis
    // USER CODE END board_init.initSpis
}

fn initI2cs() !void {
    // STM32F1 MicroZig I2C setup generated from CubeMX I2C components.
{% for i2c in i2cs %}
    try {{ i2c.alias }}.runtime_apply(.{
        .pclk = rcc.get_clock(.{{ i2c.instance }}),
        .speed = {{ i2c.speed }},
        .mode = .{{ i2c.mode }},
    });
{% else %}
    // No I2C setup inferred.
{% endfor %}
    // USER CODE BEGIN board_init.initI2cs
    // USER CODE END board_init.initI2cs
}

