const GpioMode = enum(u2) {
    input = 0b00,
    output = 0b01,
    alternate = 0b10,
    analog = 0b11,
};

const GpioPort = enum {
    GPIOA,
    GPIOB,
    GPIOC,
    GPIOD,
    GPIOE,
    GPIOF,
    GPIOG,
    GPIOH,
    GPIOI,
    GPIOJ,
    GPIOK,
};

fn enableGpioPort(comptime port: GpioPort) void {
    const field = @tagName(port) ++ "EN";
    RCC.AHB1ENR.modify_one(field, 1);
}

fn setGpioMode(port: anytype, comptime pin: u4, mode: GpioMode) void {
    const shift: u5 = @as(u5, pin) * 2;
    const mask: u32 = @as(u32, 0b11) << shift;
    port.MODER.raw = (port.MODER.raw & ~mask) | (@as(u32, @intFromEnum(mode)) << shift);
}

fn setGpioAlternate(port: anytype, comptime pin: u4, comptime af: u4) void {
    const shift: u5 = @as(u5, pin % 8) * 4;
    const mask: u32 = @as(u32, 0b1111) << shift;
    if (pin < 8) {
        port.AFR[0].raw = (port.AFR[0].raw & ~mask) | (@as(u32, af) << shift);
    } else {
        port.AFR[1].raw = (port.AFR[1].raw & ~mask) | (@as(u32, af) << shift);
    }
}

