pub const gpio_config = if (comptime @hasDecl(stm32, "pins") and @hasDecl(stm32.pins, "GlobalConfiguration"))
    stm32.pins.GlobalConfiguration{
{% for port in ports %}
        .{{ port.name }} = .{
{% for pin in port.pins %}
            .{{ pin.field }} = .{ .name = "{{ pin.alias }}", .mode = {% if pin.mode.kind == "output" %}.{ .output = .{ .resistor = .{{ pin.mode.pull }}, .o_type = .{{ pin.mode.output_type }}, .o_speed = .{{ pin.mode.speed }} } }{% elif pin.mode.kind == "input" %}.{ .input = .{ .resistor = .{{ pin.mode.pull }} } }{% elif pin.mode.kind == "analog" %}.{ .analog = .{ .resistor = .{{ pin.mode.pull }} } }{% else %}.{ .alternate_function = .{ .afr = .{{ pin.mode.alternate }}, .resistor = .{{ pin.mode.pull }}, .o_type = .{{ pin.mode.output_type }}, .o_speed = .{{ pin.mode.speed }} } }{% endif %} },
{% endfor %}
        },
{% else %}
        // No GPIO pins selected.
{% endfor %}
    }
else
    struct {}{};

fn initClocks() !void {
    if (comptime @hasDecl(stm32, "rcc") and @hasDecl(stm32.rcc, "apply")) {
        stm32.rcc.apply();
    }
    // pins.GlobalConfiguration.apply() usually enables GPIO port clocks.
    // Still review peripheral clocks explicitly:
{{ clock_todos }}
    // CubeMX RCC summary:
{{ rcc_comments }}
    // USER CODE BEGIN board_init.initClocks
    // USER CODE END board_init.initClocks
}

fn initGpio() void {
    if (comptime @hasDecl(stm32, "pins") and @hasDecl(stm32.pins, "GlobalConfiguration")) {
        const applied_pins = gpio_config.apply();
        _ = applied_pins;
    } else {
        @compileLog("This MicroZig STM32 target has no hal.pins.GlobalConfiguration; use --gpio-api data for a portable skeleton.");
    }
    // USER CODE BEGIN board_init.initGpio
    // USER CODE END board_init.initGpio
}

