fn initUarts() !void {
    // MicroZig UART v3 setup generated from CubeMX USART/UART components.
{% for uart in uarts %}
    _ = stm32.uart.Uart(.{{ uart.instance }}).init(.{});
{% else %}
    // No UART setup inferred.
{% endfor %}
